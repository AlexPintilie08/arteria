# Local API configuration. The defaults work without an AI provider key.
ARTERIA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Optional cloud AI planning provider. Keep real credentials in an untracked .env.
ARTERIA_AI_ENABLED=false
ARTERIA_AI_PROVIDER=openai
ARTERIA_AI_MODEL=gpt-4o-mini
ARTERIA_AI_API_KEY=
ARTERIA_AI_BASE_URL=https://api.openai.com/v1
ARTERIA_AI_TIMEOUT_SECONDS=18
