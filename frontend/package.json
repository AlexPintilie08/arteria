{
  "name": "arteria-frontend",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["web", "mobile", "shared"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "npm run dev --workspace @arteria/web",
    "android": "npm run android --workspace @arteria/mobile",
    "mobile": "npm run start --workspace @arteria/mobile",
    "build": "npm run build --workspace @arteria/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --experimental-strip-types --test shared/tests/*.test.ts web/tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": { "typescript": "~5.9.3" }
}
